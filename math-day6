<!DOCTYPE html>
<html lang="zh-HK">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>🚂 數學探索島・第 6 日：森林小火車</title>
  <style>
    /* =========================================
       iPad Safari 終極防護引擎 & 基礎設定
       ========================================= */
    * {
      box-sizing: border-box;
      touch-action: manipulation;
      user-select: none;
      -webkit-user-select: none;
      -webkit-tap-highlight-color: transparent;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100vh;
      font-family: "PingFang HK", "Hiragino Sans GB", "Microsoft JhengHei", sans-serif;
      /* 森林漸變背景 */
      background: linear-gradient(180deg, #dcfce7 0%, #bbf7d0 55%, #86efac 100%);
      color: #0f172a;
      overflow-x: hidden;
    }

    /* 背景飄落樹葉裝飾 */
    .leaves {
      position: fixed;
      inset: 0;
      pointer-events: none;
      overflow: hidden;
      z-index: 0;
    }
    .leaf {
      position: absolute;
      top: -60px;
      font-size: 1.5rem;
      opacity: 0.4;
      animation: fallDown linear infinite;
    }
    @keyframes fallDown {
      0% { transform: translateY(0) rotate(0deg); opacity: 0.6; }
      100% { transform: translateY(115vh) rotate(360deg); opacity: 0; }
    }

    /* 主容器 */
    .app-wrapper {
      position: relative;
      z-index: 1;
      max-width: 860px;
      margin: 0 auto;
      padding: 14px 18px 36px;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    /* 頂部導航列與進度圓點 */
    .top-nav {
      background: rgba(255, 255, 255, 0.92);
      border-radius: 24px;
      padding: 12px 18px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
      box-shadow: 0 6px 0 #86efac, 0 10px 20px rgba(22, 163, 74, 0.12);
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .home-btn {
      text-decoration: none;
      background: #fef08a;
      color: #854d0e;
      font-weight: 800;
      font-size: 1rem;
      padding: 8px 14px;
      border-radius: 16px;
      border-bottom: 4px solid #eab308;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      transition: transform 0.1s;
    }
    .home-btn:active {
      transform: translateY(3px);
      border-bottom-width: 1px;
    }

    .theme-title {
      font-size: 1.2rem;
      font-weight: 900;
      color: #166534;
      letter-spacing: 0.5px;
    }

    .step-dots {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .step-dot {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #dcfce7;
      border: 3px solid #86efac;
      color: #166534;
      font-weight: 800;
      font-size: 0.9rem;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.2s ease;
    }
    .step-dot.active {
      background: #facc15;
      border-color: #ca8a04;
      color: #713f12;
      transform: scale(1.18);
    }
    .step-dot.done {
      background: #4ade80;
      border-color: #16a34a;
      color: #ffffff;
    }

    /* Anna 老師語音橫幅 */
    .teacher-banner {
      background: #ffffff;
      border-radius: 26px;
      padding: 16px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      border: 3px solid #4ade80;
      box-shadow: 0 7px 0 #4ade80;
    }

    .teacher-info {
      display: flex;
      align-items: center;
      gap: 14px;
      flex: 1;
    }

    .teacher-avatar {
      width: 64px;
      height: 64px;
      border-radius: 50%;
      background: linear-gradient(135deg, #fde047, #f59e0b);
      border: 4px solid #ffffff;
      box-shadow: 0 4px 10px rgba(245, 158, 11, 0.35);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.2rem;
      flex-shrink: 0;
    }

    .question-text {
      font-size: 1.32rem;
      font-weight: 800;
      color: #14532d;
      line-height: 1.45;
    }

    .speak-btn {
      background: linear-gradient(180deg, #4ade80 0%, #16a34a 100%);
      color: #ffffff;
      border: none;
      border-bottom: 5px solid #15803d;
      border-radius: 20px;
      padding: 12px 18px;
      font-size: 1.1rem;
      font-weight: 800;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      flex-shrink: 0;
      box-shadow: 0 4px 10px rgba(22, 163, 74, 0.25);
    }
    .speak-btn:active {
      transform: translateY(4px);
      border-bottom-width: 1px;
    }

    /* 題目視覺主舞台 */
    .stage-card {
      background: rgba(255, 255, 255, 0.96);
      border-radius: 30px;
      padding: 24px 20px;
      min-height: 250px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 16px;
      box-shadow: 0 9px 0 #86efac, 0 14px 28px rgba(22, 163, 74, 0.14);
      position: relative;
    }

    .stage-badge {
      background: #dcfce7;
      color: #166534;
      font-size: 0.98rem;
      font-weight: 800;
      padding: 6px 16px;
      border-radius: 999px;
      border: 2px solid #bbf7d0;
    }

    /* 規律與車廂序列卡片 */
    .pattern-row, .train-sequence-row {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 6px;
      margin: 8px 0;
    }

    .train-head {
      font-size: 4rem;
      margin-right: 8px;
      filter: drop-shadow(0 4px 0 rgba(0,0,0,0.1));
    }

    .pattern-tile, .train-car {
      width: 72px;
      height: 72px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.4rem;
      font-weight: 900;
      box-shadow: 0 5px 0 rgba(0, 0, 0, 0.15);
      border: 3px solid #cbd5e1;
      background: #f8fafc;
      color: #334155;
      position: relative;
    }
    
    /* 車廂連接器 */
    .train-car::before {
      content: "";
      position: absolute;
      left: -12px;
      top: 50%;
      transform: translateY(-50%);
      width: 10px;
      height: 6px;
      background: #475569;
      border-radius: 2px;
    }
    .train-head + .train-car::before {
      display: none;
    }

    .train-car.red-hi { background: #fecaca; border-color: #ef4444; box-shadow: 0 5px 0 #dc2626; }
    .train-car.blue-hi { background: #bfdbfe; border-color: #3b82f6; box-shadow: 0 5px 0 #2563eb; color: #1e3a8a; }
    .train-car.green-hi { background: #bbf7d0; border-color: #22c55e; box-shadow: 0 5px 0 #16a34a; }

    .train-car.mystery {
      background: #fffbeb;
      border: 4px dashed #f59e0b;
      color: #d97706;
      font-size: 2.2rem;
      animation: pulseMystery 1.4s infinite ease-in-out;
    }
    
    .pattern-tile.mystery {
      background: #fffbeb;
      border: 4px dashed #f59e0b;
      color: #d97706;
      animation: pulseMystery 1.4s infinite ease-in-out;
    }

    @keyframes pulseMystery {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.07); }
    }

    /* 前後排隊區域 (Q3, Q4) */
    .queue-row {
      display: flex;
      align-items: flex-end;
      justify-content: center;
      gap: 16px;
      padding-bottom: 20px;
      border-bottom: 6px solid #a3e635; /* 草地 */
      position: relative;
      width: 100%;
      max-width: 500px;
    }
    
    .bus-stop {
      position: absolute;
      left: 0;
      bottom: -6px;
      font-size: 3.5rem;
    }

    .queue-animal {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
    }
    .queue-animal .emoji {
      font-size: 3.5rem;
    }
    .queue-animal .label {
      background: #ffffff;
      border: 2px solid #cbd5e1;
      border-radius: 12px;
      padding: 2px 8px;
      font-size: 0.9rem;
      font-weight: 800;
      color: #475569;
    }

    /* 比較大小 (Q5) */
    .compare-zone {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 20px;
      width: 100%;
    }
    .compare-box {
      flex: 1;
      background: #f0fdf4;
      border: 4px solid #4ade80;
      border-radius: 24px;
      padding: 20px 10px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      box-shadow: 0 6px 0 #bbf7d0;
    }
    .compare-items {
      font-size: 2.5rem;
      line-height: 1.2;
      text-align: center;
      min-height: 80px;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
    }

    /* 可點擊數數物件 */
    .countable-item {
      position: relative;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 78px;
      height: 78px;
      border-radius: 22px;
      background: #ffffff;
      border: 3px solid #bbf7d0;
      box-shadow: 0 5px 0 #86efac;
      font-size: 2.8rem;
      cursor: pointer;
      transition: transform 0.12s, background 0.15s;
    }
    .countable-item.counted {
      background: #fef9c3;
      border-color: #eab308;
      box-shadow: 0 5px 0 #ca8a04;
      transform: scale(1.08);
    }
    .count-tag {
      position: absolute;
      top: -10px;
      right: -10px;
      width: 30px;
      height: 30px;
      border-radius: 50%;
      background: #f97316;
      color: #ffffff;
      font-size: 1rem;
      font-weight: 900;
      display: flex;
      align-items: center;
      justify-content: center;
      border: 2px solid #ffffff;
      box-shadow: 0 2px 6px rgba(0,0,0,0.2);
    }

    /* 加法分格區塊 (Q7) */
    .math-equation-visual {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 14px;
    }

    .group-box {
      background: #f0fdf4;
      border: 4px solid #4ade80;
      border-radius: 24px;
      padding: 14px 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      box-shadow: 0 6px 0 #bbf7d0;
    }

    .group-items {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    .group-label {
      font-size: 1.15rem;
      font-weight: 900;
      color: #166534;
      background: #ffffff;
      padding: 3px 12px;
      border-radius: 999px;
    }

    .math-symbol {
      font-size: 2.6rem;
      font-weight: 900;
      color: #15803d;
    }

    /* 減法動態視覺 (Q8) */
    .subtraction-zone {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 16px;
      padding: 12px;
    }
    .honey-card {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      padding: 12px 14px;
      border-radius: 24px;
      background: #fffbeb;
      border: 4px solid #f59e0b;
      box-shadow: 0 6px 0 #d97706;
      cursor: pointer;
    }
    .honey-card .emoji-big {
      font-size: 3rem;
    }
    .honey-card .status-pill {
      font-size: 0.92rem;
      font-weight: 800;
      padding: 3px 10px;
      border-radius: 999px;
      background: #f59e0b;
      color: #ffffff;
    }
    .honey-card.eaten {
      background: #f8fafc;
      border: 4px dashed #94a3b8;
      box-shadow: none;
      opacity: 0.5;
    }
    .honey-card.eaten .status-pill {
      background: #64748b;
      color: #ffffff;
    }

    .tap-tip {
      font-size: 0.98rem;
      font-weight: 700;
      color: #15803d;
      background: #dcfce7;
      padding: 5px 14px;
      border-radius: 999px;
    }

    /* 溫柔提示框 (Gentle Hint Box - 絕無 ❌ 符號) */
    .gentle-hint-box {
      display: none;
      width: 100%;
      background: #fffbeb;
      border: 3px solid #fbbf24;
      border-radius: 22px;
      padding: 14px 18px;
      align-items: center;
      gap: 12px;
      box-shadow: 0 5px 0 #fcd34d;
      animation: popIn 0.25s ease;
    }
    .gentle-hint-box.visible {
      display: flex;
    }
    .hint-icon {
      font-size: 2rem;
      flex-shrink: 0;
    }
    .hint-text {
      font-size: 1.15rem;
      font-weight: 800;
      color: #92400e;
      line-height: 1.4;
    }

    /* 選項按鈕區 */
    .options-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }

    .option-btn {
      background: #ffffff;
      border: 3px solid #4ade80;
      border-bottom: 8px solid #16a34a;
      border-radius: 26px;
      padding: 18px 12px;
      font-size: 2rem;
      font-weight: 900;
      color: #14532d;
      cursor: pointer;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      box-shadow: 0 8px 16px rgba(22, 163, 74, 0.14);
      transition: transform 0.1s, background 0.15s;
    }
    .option-btn:active {
      transform: translateY(5px);
      border-bottom-width: 3px;
    }
    .option-sub {
      font-size: 1.05rem;
      font-weight: 800;
      color: #166534;
    }

    /* 防呆搖晃動畫 */
    .wrong-shake {
      animation: shakeGentle 0.42s ease;
      background: #fef3c7 !important;
      border-color: #f59e0b !important;
      border-bottom-color: #d97706 !important;
    }
    @keyframes shakeGentle {
      0%, 100% { transform: translateX(0); }
      22% { transform: translateX(-8px); }
      45% { transform: translateX(8px); }
      68% { transform: translateX(-5px); }
      85% { transform: translateX(5px); }
    }

    /* 答對發光狀態 */
    .correct-pop {
      background: #dcfce7 !important;
      border-color: #22c55e !important;
      border-bottom-color: #15803d !important;
      color: #14532d !important;
      transform: scale(1.04);
    }

    /* 下一題按鈕 */
    .next-action-wrap {
      display: none;
      justify-content: center;
      margin-top: 4px;
    }
    .next-action-wrap.visible {
      display: flex;
    }
    .next-btn {
      background: linear-gradient(180deg, #facc15 0%, #eab308 100%);
      color: #713f12;
      border: none;
      border-bottom: 7px solid #ca8a04;
      border-radius: 26px;
      padding: 16px 38px;
      font-size: 1.45rem;
      font-weight: 900;
      cursor: pointer;
      box-shadow: 0 10px 20px rgba(234, 179, 8, 0.3);
      animation: popIn 0.25s ease;
    }
    .next-btn:active {
      transform: translateY(5px);
      border-bottom-width: 2px;
    }

    @keyframes popIn {
      0% { transform: scale(0.92); opacity: 0; }
      100% { transform: scale(1); opacity: 1; }
    }

    /* 開場歡迎遮罩 */
    .start-overlay {
      position: fixed;
      inset: 0;
      z-index: 50;
      background: rgba(20, 83, 45, 0.78);
      backdrop-filter: blur(6px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .start-modal {
      background: #ffffff;
      border-radius: 34px;
      padding: 32px 26px;
      max-width: 480px;
      width: 100%;
      text-align: center;
      border: 5px solid #4ade80;
      box-shadow: 0 12px 0 #16a34a;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 16px;
    }
    .start-modal h1 {
      margin: 0;
      font-size: 1.8rem;
      color: #166534;
    }
    .start-modal p {
      margin: 0;
      font-size: 1.15rem;
      font-weight: 700;
      color: #334155;
      line-height: 1.5;
    }
    .start-btn {
      background: linear-gradient(180deg, #facc15 0%, #eab308 100%);
      color: #713f12;
      border: none;
      border-bottom: 7px solid #ca8a04;
      border-radius: 26px;
      padding: 16px 36px;
      font-size: 1.45rem;
      font-weight: 900;
      cursor: pointer;
      width: 100%;
    }
    .start-btn:active {
      transform: translateY(5px);
      border-bottom-width: 2px;
    }

    /* 結算報告畫面 */
    .summary-card {
      display: none;
      background: #ffffff;
      border-radius: 32px;
      padding: 26px 22px;
      border: 4px solid #facc15;
      box-shadow: 0 10px 0 #eab308;
      flex-direction: column;
      align-items: center;
      gap: 18px;
    }
    .summary-card.visible {
      display: flex;
    }

    .trophy-header { text-align: center; }
    .trophy-header .trophy-icon { font-size: 4rem; }
    .trophy-header h2 { margin: 6px 0 4px; font-size: 1.75rem; color: #166534; }
    .trophy-header p { margin: 0; font-size: 1.1rem; font-weight: 700; color: #475569; }

    .report-table {
      width: 100%;
      border-collapse: collapse;
      border-radius: 18px;
      overflow: hidden;
      font-size: 1rem;
    }
    .report-table th { background: #16a34a; color: #ffffff; padding: 12px 10px; font-weight: 800; text-align: center; }
    .report-table td { padding: 11px 10px; border-bottom: 2px solid #dcfce7; text-align: center; font-weight: 700; color: #1e293b; }
    .report-table tr:nth-child(even) td { background: #f8fafc; }

    .copy-box {
      width: 100%;
      background: #f0fdf4;
      border: 3px dashed #4ade80;
      border-radius: 22px;
      padding: 16px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
    }

    .secret-code-preview {
      width: 100%;
      background: #ffffff;
      border: 2px solid #bbf7d0;
      border-radius: 14px;
      padding: 10px 12px;
      font-size: 0.92rem;
      font-weight: 700;
      color: #166534;
      word-break: break-all;
      user-select: text;
      -webkit-user-select: text;
    }

    .copy-btn {
      background: linear-gradient(180deg, #4ade80 0%, #16a34a 100%);
      color: #ffffff;
      border: none;
      border-bottom: 6px solid #15803d;
      border-radius: 22px;
      padding: 15px 26px;
      font-size: 1.2rem;
      font-weight: 900;
      cursor: pointer;
      width: 100%;
      max-width: 440px;
    }
    .copy-btn:active { transform: translateY(4px); border-bottom-width: 2px; }

    .copy-toast {
      display: none;
      background: #dcfce7;
      border: 2px solid #22c55e;
      color: #14532d;
      font-weight: 800;
      font-size: 1.05rem;
      padding: 10px 16px;
      border-radius: 16px;
      text-align: center;
    }
    .copy-toast.visible { display: block; }

    @media (max-width: 600px) {
      .pattern-tile, .train-car, .countable-item { width: 62px; height: 62px; font-size: 2.2rem; }
      .question-text { font-size: 1.15rem; }
      .option-btn { font-size: 1.7rem; padding: 14px 8px; }
      .queue-animal .emoji { font-size: 2.5rem; }
      .train-head { font-size: 3rem; }
    }
  </style>
</head>
<body>

  <!-- 森林飄落樹葉背景 -->
  <div class="leaves" id="leavesContainer"></div>

  <!-- 開場解鎖廣東話語音遮罩 -->
  <div class="start-overlay" id="startOverlay">
    <div class="start-modal">
      <div style="font-size: 4.2rem;">🚂🦁🍎</div>
      <h1>數學探索島・第 6 日</h1>
      <p>歡迎嚟到《森林小火車》！<br>準備好同 Anna 老師一齊搭火車、學排隊未呀？</p>
      <button class="start-btn" id="startBtn">🚂 火車準備開出！</button>
    </div>
  </div>

  <div class="app-wrapper">
    <!-- 頂部導航列與進度圓點 -->
    <header class="top-nav">
      <div class="nav-left">
        <a href="index.html" class="home-btn">🏠 返回樂園</a>
        <div class="theme-title">🚂 第 6 日：森林小火車</div>
      </div>
      <div class="step-dots" id="stepDots"></div>
    </header>

    <!-- 測驗進行區 -->
    <main id="quizSection" style="display: flex; flex-direction: column; gap: 14px;">
      <!-- Anna 老師提問橫幅 -->
      <section class="teacher-banner">
        <div class="teacher-info">
          <div class="teacher-avatar">👩‍🏫</div>
          <div class="question-text" id="questionText">準備搭森林小火車啦！</div>
        </div>
        <button class="speak-btn" id="replayBtn">🔊 再聽一次</button>
      </section>

