        const eqSign = document.createElement("div"); eqSign.className = "math-symbol"; eqSign.textContent = "＝ ❓";

        eqWrap.appendChild(leftBox); eqWrap.appendChild(plusSign); eqWrap.appendChild(rightBox); eqWrap.appendChild(eqSign);
        visualStageEl.appendChild(eqWrap);
        
        const tip = document.createElement("div");
        tip.className = "tap-tip";
        tip.textContent = "👆 可以用手指逐隻雀仔點一點幫手數數！";
        visualStageEl.appendChild(tip);

      } else if (q.type === "subtraction-honey") {
        const subZone = document.createElement("div");
        subZone.className = "subtraction-zone";
        const stayCount = q.totalCount - q.awayCount;

        for (let i = 0; i < q.totalCount; i++) {
          const isEaten = i >= stayCount;
          const card = document.createElement("div");
          card.className = "honey-card" + (isEaten ? " eaten" : "");

          const emo = document.createElement("div");
          emo.className = "emoji-big"; emo.textContent = "🍯";
          const pill = document.createElement("div");
          pill.className = "status-pill"; pill.textContent = isEaten ? "食咗啦" : "未食架";

          card.appendChild(emo); card.appendChild(pill);
          if (!isEaten) {
            card.addEventListener("click", () => {
              playTone("tap"); speakCantonese(String(i + 1));
              card.style.transform = "scale(1.1)"; setTimeout(() => { card.style.transform = ""; }, 180);
            });
          }
          subZone.appendChild(card);
        }
        visualStageEl.appendChild(subZone);
      }

      /* 渲染選項按鈕 */
      q.options.forEach(opt => {
        const btn = document.createElement("button");
        btn.className = "option-btn";
        btn.innerHTML = `<span style="${q.type === 'comparison' ? 'font-size:1.6rem; letter-spacing:2px;' : ''}">${opt.main}</span><span class="option-sub">${opt.sub}</span>`;

        btn.addEventListener("click", () => {
          if (questionSolved) return;
          if (opt.isCorrect) {
            questionSolved = true;
            const elapsedSec = Math.max(1, Math.round((Date.now() - questionStartTime) / 1000));
            btn.classList.add("correct-pop");
            playTone("correct");
            gentleHintBoxEl.classList.remove("visible");

            resultsLog.push({ id: q.id, reportLabel: q.reportLabel, seconds: elapsedSec, needsHint: currentNeedsHint });

            nextBtnEl.textContent = currentIndex === quizData.length - 1 ? "🏆 睇吓今日嘅成績表！" : "➡️ 繼續前進下一關！";
            nextActionWrapEl.classList.add("visible");
            speakCantonese(q.praiseSpeech);
          } else {
            currentNeedsHint = true;
            playTone("gentle");
            btn.classList.remove("wrong-shake");
            void btn.offsetWidth;
            btn.classList.add("wrong-shake");
            gentleHintTextEl.textContent = q.hintDisplay;
            gentleHintBoxEl.classList.add("visible");
            speakCantonese(q.hintSpeech);
          }
        });
        optionsGridEl.appendChild(btn);
      });

      questionStartTime = Date.now();
      speakCantonese(q.questionSpeech);
    }

    function showSummaryReport() {
      document.getElementById("quizSection").style.display = "none";
      document.getElementById("summaryCard").classList.add("visible");

      stepDotsEl.innerHTML = "";
      quizData.forEach(() => {
        const dot = document.createElement("div"); dot.className = "step-dot done"; dot.textContent = "✓";
        stepDotsEl.appendChild(dot);
      });

      const tbody = document.getElementById("reportTableBody");
      tbody.innerHTML = "";
      const codeParts = ["【數學測驗回報】Day 6 (森林小火車)"];

      resultsLog.forEach(item => {
        const tr = document.createElement("tr");
        const statusText = item.needsHint ? "💡 需提示" : "✅ 1次答對";
        tr.innerHTML = `<td>${item.reportLabel}</td><td>${statusText}</td><td>${item.seconds}s</td>`;
        tbody.appendChild(tr);
        codeParts.push(`${item.reportLabel}: ${item.seconds}s${item.needsHint ? "(需提示)" : ""}`);
      });

      document.getElementById("secretCodePreview").textContent = codeParts.join(" | ");
      speakCantonese("哇！玲玲好叻女呀，森林小火車順利到站啦！請媽媽撳下面粒掣，將成績暗號傳送俾 Anna 老師啦！");
    }

    /* 一鍵複製進度暗號 */
    document.getElementById("copyReportBtn").addEventListener("click", () => {
      const codeText = document.getElementById("secretCodePreview").textContent;
      const toast = document.getElementById("copyToast");
      const copyBtn = document.getElementById("copyReportBtn");

      function onCopySuccess() {
        playTone("correct"); toast.classList.add("visible"); copyBtn.textContent = "✅ 已複製好進度暗號！";
      }

      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(codeText).then(onCopySuccess).catch(() => fallbackCopy(codeText, onCopySuccess));
      } else {
        fallbackCopy(codeText, onCopySuccess);
      }
    });

    function fallbackCopy(text, callback) {
      const ta = document.createElement("textarea");
      ta.value = text; ta.style.position = "fixed"; ta.style.opacity = "0";
      document.body.appendChild(ta); ta.focus(); ta.select();
      try { document.execCommand("copy"); callback(); } catch (e) {}
      document.body.removeChild(ta);
    }

    /* 按鈕事件綁定 */
    document.getElementById("startBtn").addEventListener("click", () => {
      document.getElementById("startOverlay").style.display = "none";
      playTone("tap"); renderQuestion(0);
    });
    document.getElementById("replayBtn").addEventListener("click", () => {
      if (quizData[currentIndex]) speakCantonese(quizData[currentIndex].questionSpeech);
    });
    nextBtnEl.addEventListener("click", () => {
      playTone("tap");
      if (currentIndex < quizData.length - 1) { currentIndex++; renderQuestion(currentIndex); } 
      else { showSummaryReport(); }
    });

    initLeaves();
    renderStepDots();
  </script>
</body>
</html>
