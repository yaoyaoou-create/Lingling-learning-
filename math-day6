    function renderStepDots() {
      stepDotsEl.innerHTML = "";
      quizData.forEach((q, idx) => {
        const dot = document.createElement("div");
        dot.className = "step-dot";
        if (idx < currentIndex) dot.classList.add("done");
        if (idx === currentIndex && !document.getElementById("summaryCard").classList.contains("visible")) {
          dot.classList.add("active");
        }
        dot.textContent = idx < currentIndex ? "✓" : (idx + 1);
        stepDotsEl.appendChild(dot);
      });
    }

    function createCountableItem(emoji) {
      const item = document.createElement("div");
      item.className = "countable-item";
      item.textContent = emoji;

      item.addEventListener("click", () => {
        playTone("tap");
        if (item.dataset.counted === "1") {
          item.dataset.counted = "0";
          item.classList.remove("counted");
          const oldTag = item.querySelector(".count-tag");
          if (oldTag) oldTag.remove();
          recalculateCountTags();
        } else {
          tapCountCounter++;
          item.dataset.counted = "1";
          item.classList.add("counted");
          const tag = document.createElement("span");
          tag.className = "count-tag";
          tag.textContent = tapCountCounter;
          item.appendChild(tag);
          speakCantonese(String(tapCountCounter));
        }
      });
      return item;
    }

